{
  "name": "@light-cat/ai-commit-msg",
  "version": "1.1.6",
  "type": "module",
  "description": "AI-powered commit message generator for git",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-commit": "bin/ai-commit.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/ai-commit.js",
    "prepare": "npm run build",
    "setup": "node bin/install.js"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "commit-message",
    "cli",
    "conventional-commits",
    "git-hooks",
    "openai",
    "deepseek"
  ],
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "author": "EvilIrving",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvilIrving/ai-commit.git"
  },
  "homepage": "https://github.com/EvilIrving/ai-commit#readme",
  "bugs": {
    "url": "https://github.com/EvilIrving/ai-commit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "js-yaml": "^4.1.1",
    "openai": "^4.20.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "simple-git-hooks": "^2.13.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2"
  }
}
