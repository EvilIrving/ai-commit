# Environment variables for @light-cat/ai-commit-msg
# Copy this file to .env and fill in your values

# Required. OPENAI_API_KEY is also accepted.
AI_API_KEY=your-api-key-here

# Optional. OPENAI_BASE_URL / OPENAI_API_BASE / OPENAI_MODEL are also accepted.
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-luna
AI_TIMEOUT_MS=30000

# DeepSeek (OpenAI-compatible)
# AI_API_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash
# AI_API_KEY=your-deepseek-api-key

# Azure OpenAI only, if your endpoint needs it
# OPENAI_API_VERSION=2024-02-15-preview

# ============================================================================
# Custom Prompts
# ============================================================================
# For custom prompts, create a .ai-commitrc file in your project root or home directory.
# See .ai-commitrc.example for configuration examples.
#
# Supported file formats: .ai-commitrc, .ai-commitrc.yml, .ai-commitrc.yaml, .ai-commitrc.json
#
# Advanced: AI_COMMITRC_PATH=/path/to/.ai-commitrc
