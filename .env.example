# Environment variables for @light-cat/ai-commit-msg
# Copy this file to .env and fill in your values

# Required
AI_API_KEY=your-api-key-here

# Optional - defaults to OpenAI
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4

# ============================================================================
# Custom Prompts
# ============================================================================
# For custom prompts, create a .ai-commitrc file in your project root or home directory.
# See .ai-commitrc.example for configuration examples.
#
# Supported file formats: .ai-commitrc, .ai-commitrc.yml, .ai-commitrc.yaml, .ai-commitrc.json
#
# Advanced: AI_COMMITRC_PATH=/path/to/.ai-commitrc
