# Environment variables for @light-cat/ai-commit-msg
# Copy this file to .env and fill in your values

# Required
AI_API_KEY=your-api-key-here

# Optional - defaults to OpenAI
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4

# Optional tuning
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=100

# ============================================================================
# Custom Prompts (Recommended: use .ai-commitrc file instead)
# ============================================================================
# For long prompts, create a .ai-commitrc file in your project root or home directory.
# See .ai-commitrc.example for configuration examples.
#
# Environment variables (not recommended for long prompts):
# AI_SYSTEM_PROMPT=your system prompt here
# AI_USER_PROMPT_TEMPLATE=your user prompt template here
#
# Variables available in userPromptTemplate: {{diff}}, {{branch}}, {{lastCommit}}
#
# Advanced: AI_COMMITRC_PATH=/path/to/.ai-commitrc
